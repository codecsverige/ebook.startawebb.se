# Canonical URL. Start with your Vercel URL, then switch to the subdomain.
APP_URL=http://localhost:3000

# A NEW Supabase project, isolated from your existing websites.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# On Vercel use its automatic OIDC authentication; locally use a Gateway key.
AI_GATEWAY_API_KEY=
# Set to a current structured-output language model ID from the live catalog.
AI_GATEWAY_MODEL=
# Optional: a language model that supports image output via generateText.
AI_GATEWAY_IMAGE_MODEL=

# One-time EUR credit packs. Create variants at EUR 9 and EUR 19.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ONE=
LEMON_SQUEEZY_VARIANT_THREE=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_TEST_MODE=true

# Required before enabling checkout. Displayed on legal pages.
OPERATOR_NAME=
SUPPORT_EMAIL=

# Optional local Chromium binary; Vercel uses the bundled Chromium package.
CHROMIUM_EXECUTABLE_PATH=
