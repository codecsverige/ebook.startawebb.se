# Stable production origin. Change after adding ebook.startawebb.se to Vercel.
APP_URL=https://ebookstartawebbse.vercel.app

# Server-only credentials for the EXISTING MashrooHub Firebase project.
# Put these directly into this new Vercel project's Environment Variables.
FIREBASE_PROJECT_ID=mashroohub-aa66a
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional public Web App overrides. Defaults already identify MashrooHub.
# To move projects, set ALL five public values and matching server credentials.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mashroohub-aa66a
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mashroohub-aa66a.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mashroohub-aa66a.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=

# Vercel AI Gateway: OIDC on Vercel, API key only for local development.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
AI_GATEWAY_IMAGE_MODEL=

LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ONE=
LEMON_SQUEEZY_VARIANT_THREE=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_TEST_MODE=true
OPERATOR_NAME=
SUPPORT_EMAIL=
CHROMIUM_EXECUTABLE_PATH=
