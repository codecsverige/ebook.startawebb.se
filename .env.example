# Stable production origin. Change after adding ebook.startawebb.se to Vercel.
APP_URL=https://ebookstartawebbse.vercel.app

# One server-only secret for the EXISTING HyrNära Firebase project.
# Paste the complete downloaded service-account JSON into this Vercel variable.
EBOOK_FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional public Web App overrides. Defaults already identify HyrNära.
# The app ID is optional for Auth, Firestore and Storage.
NEXT_PUBLIC_EBOOK_FIREBASE_PROJECT_ID=hyrnara
NEXT_PUBLIC_EBOOK_FIREBASE_API_KEY=
NEXT_PUBLIC_EBOOK_FIREBASE_AUTH_DOMAIN=hyrnara.firebaseapp.com
NEXT_PUBLIC_EBOOK_FIREBASE_STORAGE_BUCKET=hyrnara.firebasestorage.app
NEXT_PUBLIC_EBOOK_FIREBASE_APP_ID=

# Direct OpenAI API only, independent of Vercel AI Gateway.
# These credentials are server-only. Historical AI_GATEWAY_* values are ignored.
OPENAI_API_KEY=
OPENAI_EBOOK_OUTLINE_MODEL=gpt-6-luna
OPENAI_EBOOK_CHAPTER_MODEL=gpt-6.1-terra
OPENAI_EBOOK_COVER_MODEL=gpt-image-1-mini

# Safety caps for EXISTING models/providers only; app never adds an AI provider.
# Limits are per UTC day, applied atomically before each billable AI request.
# These defaults are conservative. You can reduce them in Vercel.
# These limits cap request counts, not USD cost: also set an AI Gateway budget.
EBOOK_AI_GLOBAL_DAILY_LIMIT=80
EBOOK_AI_USER_DAILY_LIMIT=32
EBOOK_AI_BOOK_LIFETIME_LIMIT=40
EBOOK_AI_IMAGE_GLOBAL_DAILY_LIMIT=8
EBOOK_AI_IMAGE_USER_DAILY_LIMIT=3


# Optional: OpenAI-approved commercial Sign in with ChatGPT (identity only).
# Register this exact callback with OpenAI:
# https://ebook.startawebb.se/api/auth/chatgpt/callback
# Leave OPENAI_SIWC_CLIENT_ID blank until OpenAI issues an oaiapp_... OAuth client.
# Public OAuth clients: OPENAI_SIWC_AUTH_METHOD=none (no secret).
# Confidential clients: OPENAI_SIWC_AUTH_METHOD=client_secret_basic and a
# server-only OPENAI_SIWC_CLIENT_SECRET in Vercel (never in NEXT_PUBLIC_*).
# Sign-in does NOT itself authorize usage of ChatGPT plan tokens for AI.
OPENAI_SIWC_CLIENT_ID=
OPENAI_SIWC_AUTH_METHOD=none
OPENAI_SIWC_CLIENT_SECRET=

LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ONE=
LEMON_SQUEEZY_VARIANT_THREE=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_TEST_MODE=true
OPERATOR_NAME=
SUPPORT_EMAIL=
CHROMIUM_EXECUTABLE_PATH=
