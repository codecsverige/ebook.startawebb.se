{
  "name": "startawebb-ebook-studio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:firebase": "firebase emulators:exec --project demo-ebook-studio --config firebase.emulators.json --only firestore,auth \"node --import tsx --test tests/firebase.test.ts\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/noto-naskh-arabic": "5.3.0",
    "@sparticuz/chromium": "153.0.0",
    "ai": "7.0.153",
    "docx": "9.14.0",
    "firebase": "13.1.0",
    "firebase-admin": "14.5.0",
    "jose": "5.10.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "puppeteer-core": "25.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "workflow": "5.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "firebase-tools": "15.34.1",
    "prettier": "3.9.10",
    "tsx": "latest",
    "typescript": "latest"
  },
  "overrides": {
    "zod": "$zod",
    "undici": "7.30.1",
    "@grpc/grpc-js": "1.14.6",
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  }
}
